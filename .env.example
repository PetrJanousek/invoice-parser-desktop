# Copy to .env and fill in. This is a desktop app — data stays on this machine.
# LLM_PROVIDER=anthropic (the default) needs an API key. All of this can also
# be set from the app's Settings screen instead of editing this file — no
# restart required.

# --- LLM provider switch ---------------------------------------------------
# anthropic (the default) = Claude Haiku. openai / google = other cloud
# providers (need a key). ollama = local dev (no cost, no key).
# google = Gemini, has a generous free tier (aistudio.google.com).
LLM_PROVIDER=anthropic
# Optional model override; blank = per-provider default
#   anthropic -> claude-haiku-4-5 ; openai -> gpt-4o-mini
#   google -> gemini-flash-latest    ; ollama -> qwen2.5:7b
LLM_MODEL=
# Vision model for scanned/image PDFs (no extractable text); blank = default
#   anthropic -> claude-haiku-4-5 ; openai -> gpt-4o-mini
#   google -> gemini-flash-latest    ; ollama -> qwen2.5vl:7b
# Cloud models are multimodal (same as text); Ollama needs a vision model.
LLM_VISION_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Free Gemini key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
OLLAMA_URL=http://localhost:11434

# Max unread emails processed per "Read emails now" click.
EMAIL_BATCH_CAP=20

