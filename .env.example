# Copy to .env and fill in. Locally, LLM_PROVIDER=ollama needs no API keys.
# On Render, set these in the dashboard (Environment) instead of committing .env.

# --- LLM provider switch ---------------------------------------------------
# ollama = local dev (no cost). anthropic / openai / google = production (key).
# google = Gemini, has a generous free tier (aistudio.google.com).
LLM_PROVIDER=ollama
# Optional model override; blank = per-provider default
#   anthropic -> claude-haiku-4-5 ; openai -> gpt-4o-mini
#   google -> gemini-flash-latest    ; ollama -> qwen2.5:7b
LLM_MODEL=
# Vision model for scanned/image PDFs (no extractable text); blank = default
#   anthropic -> claude-haiku-4-5 ; openai -> gpt-4o-mini
#   google -> gemini-flash-latest    ; ollama -> qwen2.5vl:7b
# Cloud models are multimodal (same as text); Ollama needs a vision model.
LLM_VISION_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Free Gemini key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
OLLAMA_URL=http://localhost:11434

# --- Supabase (Postgres + Auth) --------------------------------------------
# Create a free project at https://supabase.com, then from
#   Project Settings → API : URL + anon public key + service_role key
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_ME_ANON_KEY
SUPABASE_SERVICE_KEY=REPLACE_ME_SERVICE_ROLE_KEY

# --- App secrets -----------------------------------------------------------
# Encrypts stored email passwords. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=REPLACE_ME_FERNET_KEY

# Max unread emails processed per "Read emails now" click.
EMAIL_BATCH_CAP=20

